# Per-person settings for the robot tools. Copy to tools/robot/robot.env
# (gitignored) and edit:
#
#   cp tools/robot/robot.env.example tools/robot/robot.env
#
# Every value can also be given as an environment variable for one call,
# which wins over this file:  ROBOT_TRAINER=local tools/robot/train.sh

# Where the learner runs:
#   local  this computer (needs a GPU to keep up; works on CPU / Apple GPU
#          for short tests). The phone must reach this computer's LAN address.
#   slurm  a Slurm cluster reached over ssh. The phone must reach the compute
#          nodes directly (true for Saion from the OIST internal WiFi; check
#          this for any other cluster before anything else).
ROBOT_TRAINER=local

# Run directories on the machine the learner runs on. Each run gets
# $ROBOT_RUNS/<name>_<job id>/, plus $ROBOT_RUNS/robot_endpoints/ (where a
# started job says which node and port it listens on) and, for Slurm,
# $ROBOT_RUNS/slurm_logs/. Must be on a filesystem the login node shares.
ROBOT_RUNS=$HOME/logdir/robot

# Command run inside the job before python, to put the right python on PATH
# (module load, conda activate, source a venv). Empty: use the python already
# on PATH; for local runs the repo's .venv is used when it exists.
ROBOT_SETUP=

# --- Slurm only ---------------------------------------------------------
# ssh host of the cluster login node (an alias from ~/.ssh/config).
ROBOT_SSH=
# The dreamerv3 checkout on the cluster (a clone of oist/dreamerv3).
# train.sh runs `git pull` in it before every submission.
ROBOT_REMOTE_CODE=
# sbatch flags for the learner: partition, GPU, time limit. GPU=<name> on
# the command line picks ROBOT_SLURM_FLAGS_<name> instead, e.g.
#   ROBOT_SLURM_FLAGS_p100="-p gpu-p100 --gres=gpu:p100:1"  and  GPU=p100
ROBOT_SLURM_FLAGS="--gres=gpu:1 -t 0-8:00:00"

# Optional: number runs e<N>_<name> after the highest e<N> found in this
# command's output, run on the trainer host (local or over ssh). Empty: runs
# are named <name>_<date> and nothing is numbered.
ROBOT_NUMBERS_CMD=

# --- Phone and hardware --------------------------------------------------
# The phone's WiFi address, for tools/robot/phone_connect.sh (shown in
# Settings -> About phone -> Status, and on the robot's screen).
PHONE_IP=
# Checkouts of the other two repos (only needed to build the app / flash).
ROBOT_ANDROID_DIR=$HOME/StudioProjects/smartphone-robot-android
ROBOT_FIRMWARE_DIR=$HOME/StudioProjects/smartphone-robot-firmware
